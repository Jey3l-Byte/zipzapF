<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/list.css">
    <title>Student</title>
</head>
<body>

    <div class="topbar">
        <span>STUDENT: <%= user.fullname %></span>
        <a href="/student/history" style="margin-left:auto; margin-right:15px;">Gate History</a>
        <a href="/logout">Logout</a>
    </div>

    <div class="box">
        <h2>REGISTER VEHICLE</h2>
        <form action="/vehicle" method="POST">
            <input name="plate" type="text" placeholder="Plate Number" required>
            <select name="type" required>
                <option value="">-- Vehicle Type --</option>
                <option>Car</option>
                <option>Motorcycle</option>
                <option>Tricycle</option>
                <option>Other</option>
            </select>
            <input name="brand" type="text" placeholder="Brand" required>
            <input name="color" type="text" placeholder="Color" required>
            <button type="submit">Submit</button>
        </form>
    </div>

    <div class="box">
        <h2>APPLICATION STATUS</h2>
        <table>
            <thead>
                <tr>
                    <th>PLATE</th>
                    <th>TYPE</th>
                    <th>BRAND</th>
                    <th>COLOR</th>
                    <th>STATUS</th>
                </tr>
            </thead>
            <tbody>
                <%
                    if(vehicle.length > 0){
                        vehicle.forEach((data)=>{
                %>
                <tr>
                    <td><%= data.plate %></td>
                    <td><%= data.type %></td>
                    <td><%= data.brand %></td>
                    <td><%= data.color %></td>
                    <td><span class="badge <%= data.status %>"><%= data.status %></span></td>
                </tr>
                <%
                        })
                    } else {
                %>
                <tr><td colspan="5">No vehicle registered yet.</td></tr>
                <% } %>
            </tbody>
        </table>
    </div>

</body>
</html>
